# Direct legacy vLLM mode: mcodex talks to vLLM without starting gateway/app.py.
CODEX_API_BASE="http://112.111.7.91:7980/v1"
CODEX_API_MODE="chat"
CODEX_API_KEY="dummy"
CODEX_MODEL="DeepSeek-V4-Flash-0731"
CODEX_TOOL_TRANSPORT="prompt"
CODEX_TOOL_CHOICE="auto"
CODEX_SEND_TEMPERATURE="true"
CODEX_DEBUG_REQUESTS="true"
CODEX_ENV_OVERRIDE="true"

# Context limits: server max_model_len=131072 (128K actual tokens).
# CLI estimate (len(json)//2) overestimates by ~4x for ASCII, ~1.5x for mixed.
# Compression triggers at ~80K estimated = ~20-50K actual, leaving room for output.
CODEX_MAX_CONTEXT_TOKENS="100000"
CODEX_CONTEXT_RESERVE_TOKENS="20000"
CODEX_KEEP_RECENT_TURNS="8"

# Cap output tokens.  Thinking models use output tokens for <think>.
CODEX_MAX_OUTPUT_TOKENS="16384"

# Auto-retry streaming connection drops (incomplete chunked read, peer closed,
# or stream ending without [DONE] / finish_reason).
CODEX_STREAM_RETRY_COUNT="4"
CODEX_STREAM_RETRY_DELAY="1.0"

# Read timeout: if no data arrives for 120s, treat as dead connection.
CODEX_STREAM_READ_TIMEOUT="120"
