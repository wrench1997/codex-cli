# =========================================================
# Codex CLI - 环境变量配置模板
# =========================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下面的配置值
# 3. ⚠️ 切勿将 .env 文件提交到 Git！
# =========================================================

# ---------------------------------------------------------
# Codex CLI 配置
# ---------------------------------------------------------
# API 基地址（CLI 使用）
CODEX_API_BASE="http://127.0.0.1:8080/v1"

# API 协议模式：
# auto      = 优先原生 Responses，失败后回退旧 vLLM gateway
# responses = OpenAI 官方/中转站的 /v1/responses
# chat      = OpenAI 兼容 /v1/chat/completions（ChatGPT2API 推荐）
# gateway   = 本项目 gateway/app.py 的旧工具兼容模式
CODEX_API_MODE="auto"

# 模型名称
CODEX_MODEL="DeepSeek-V4-Flash-0731"

# API 密钥（如果使用认证）
CODEX_API_KEY="dummy"

# 采样温度（0.0 - 2.0）
# 建议：代码任务 0.15~0.25，讨论/设计 0.6~0.8
CODEX_TEMPERATURE="0.2"

# 原生 Responses 模式默认不发送 temperature（GPT-5/部分中转站不支持）。
# 只有确认上游支持时才设置为 true。
CODEX_SEND_TEMPERATURE="false"

# 工具传输模式：
# native = 仅原生 Responses function_call
# prompt = JSON 标签文本工具调用，最适合会吞 tools/function_call 的中转站
# hybrid = 同时发送原生 tools 并注入 XML 工具说明
CODEX_TOOL_TRANSPORT="prompt"
CODEX_TOOL_CHOICE="auto"

# 打印请求模式、工具数量和输入项类型，排查中转站问题时可设为 true
CODEX_DEBUG_REQUESTS="false"
CODEX_AGENT_REFUSAL_RETRIES="2"
CODEX_ENV_OVERRIDE="true"

# 最大工具调用轮次
CODEX_MAX_TURNS="50"

# 是否自动审批文件修改（true/false）
CODEX_AUTO_APPROVE="false"

# 默认工作目录
# CODEX_WORKSPACE="/path/to/your/workspace"

# ---------------------------------------------------------
# Gateway 上游配置（仅启动 gateway/app.py 时需要）
# ---------------------------------------------------------
# vllm = 原始 vLLM；relay = OpenAI 兼容中转站
UPSTREAM_KIND="vllm"

# 可以填写服务根地址、/v1 地址，甚至完整 chat/completions 地址；网关会自动规范化。
UPSTREAM_BASE_URL="http://your-server:7980"
UPSTREAM_MODEL="DeepSeek-V4-Flash-0731"
UPSTREAM_API_KEY=""

# 旧变量 VLLM_BASE_URL / MODEL_NAME 仍兼容，但建议改用 UPSTREAM_*。
# 原始 vLLM 通常开启；中转站通常关闭，避免私有字段被拒绝。
GATEWAY_ENABLE_THINKING="true"
GATEWAY_ENABLE_METRICS="true"
GATEWAY_INCLUDE_STREAM_USAGE="true"
UPSTREAM_TIMEOUT_SECONDS="1800"

# Metrics 刷新间隔（秒）
POLL_INTERVAL="5"

# ---------------------------------------------------------
# 计费配置（可选）
# ---------------------------------------------------------
# 输入价格（每 1M tokens，人民币）
INPUT_PRICE_PER_1M="3.0"

# 输出价格（每 1M tokens，人民币）
OUTPUT_PRICE_PER_1M="6.0"

# 缓存命中价格（每 1M tokens，人民币）
CACHED_INPUT_PRICE_PER_1M="0.025"

# TTFT 缓存命中阈值（秒）
TTFT_CACHE_HIT_THRESHOLD="0.5"
