# OpenAI-compatible relay example
# Copy the values into .env. Never commit a real API key.
CODEX_API_BASE="http://localhost:3000/v1"
CODEX_API_MODE="chat"
CODEX_API_KEY="replace-with-a-new-key"
CODEX_MODEL="gpt-5-3-mini"

# prompt 最稳：不依赖中转站原生 function_call 透传，使用 JSON 标签文本工具协议。
# 可选 native / hybrid。确认中转站完整支持原生工具调用后再切换。
CODEX_TOOL_TRANSPORT="prompt"
CODEX_TOOL_CHOICE="auto"
CODEX_DEBUG_REQUESTS="false"
CODEX_AGENT_REFUSAL_RETRIES="2"
CODEX_ENV_OVERRIDE="true"

# GPT-5 and many relays reject temperature on Responses requests.
CODEX_SEND_TEMPERATURE="false"
CODEX_MAX_TURNS="50"
CODEX_AUTO_APPROVE="false"
