# Gateway -> OpenAI-compatible relay
UPSTREAM_KIND="relay"
UPSTREAM_BASE_URL="http://localhost:3000/v1"
UPSTREAM_MODEL="gpt-5-5"
UPSTREAM_API_KEY="replace-with-relay-key"
GATEWAY_ENABLE_THINKING="false"
GATEWAY_ENABLE_METRICS="false"
GATEWAY_INCLUDE_STREAM_USAGE="false"

# mcodex -> local gateway. `gateway` keeps the old XML-tool behavior.
CODEX_API_BASE="http://127.0.0.1:8080/v1"
CODEX_API_MODE="gateway"
CODEX_API_KEY="dummy"
CODEX_MODEL="gpt-5-5"
CODEX_TOOL_TRANSPORT="native"
CODEX_SEND_TEMPERATURE="false"
CODEX_DEBUG_REQUESTS="true"
CODEX_ENV_OVERRIDE="true"
